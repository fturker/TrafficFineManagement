@model TrafficFineManagement.Web.Models.DTOs.User.UpdateUserRequest

@{
    ViewData["Title"] = "Kullanıcı Düzenle";
    var userId = ViewContext.RouteData.Values["id"];
}

<h3 class="mb-4">Kullanıcı Düzenle</h3>

<partial name="_FormMessages" />

<form method="post"
      asp-controller="User"
      asp-action="Update"
      asp-route-id="@userId">

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All"
             class="alert alert-danger"
             role="alert">
        </div>
    }

    @if (TempData["ErrorMessage"] is string message)
    {
        <div class="alert alert-danger" role="alert">
            @message
        </div>
    }

    <div>
        <label asp-for="Name">Ad / Yetkili Adı</label>
        <br />
        <input asp-for="Name" maxlength="40" required />
    </div>

    <div>
        <label asp-for="Surname">Soyad / Yetkili Soyadı</label>
        <br />
        <input asp-for="Surname" maxlength="40" required />
    </div>

    <div>
        <label asp-for="CompanyName">Şirket Adı</label>
        <br />
        <input asp-for="CompanyName" maxlength="200" />
        <p>Yalnızca ticari hesaplar için kullanılır.</p>
    </div>

    <div>
        <label asp-for="BirthDate">Doğum Tarihi</label>
        <br />
        <input asp-for="BirthDate" type="date" />
    </div>

    <div>
        <label asp-for="Address">Adres</label>
        <br />
        <textarea asp-for="Address" maxlength="250" rows="3"></textarea>
    </div>

    <br />

    <button type="submit">Güncelle</button>

    <a asp-controller="User" asp-action="Index">
        Vazgeç
    </a>

</form>