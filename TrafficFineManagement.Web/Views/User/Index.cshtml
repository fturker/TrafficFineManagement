@using TrafficFineManagement.Web.Models.DTOs.User
@model List<UserResponse>

@{
    ViewData["Title"] = "Kullanıcılar";
}

<h3 class="mb-4">Kullanıcılar</h3>

@if(@Model.Count == 0) {
    <p>Sistemde kayıtlı kullanıcı bulunamadı.</p>
}

else{
    <div class="table-responsive mb-3">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Kullanıcı Id</th>
                    <th>Kullanıcı Adı</th>
                    <th>Ad</th>
                    <th>Soyad</th>
                    <th>Şirket</th>
                    <th>İşlem</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Id</td>
                        <td>@user.UserName</td>
                        <td>@user.Name</td>
                        <td>@user.Surname</td>
                        <td>@user.CompanyName</td>
                        <td>
                            <a asp-controller="user"
                                    asp-action="update"
                                    asp-route-id="@user.Id"
                                    class="btn btn-primary">
                                Düzenle
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a class="btn btn-primary" asp-controller="user" asp-action="create">Kullanıcı Ekle</a>
