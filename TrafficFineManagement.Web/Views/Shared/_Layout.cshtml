<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trafik Cezaları Yönetim Sistemi</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TrafficFineManagement.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 m-0">
    <header>
        <nav class="navbar bg-white border-bottom">
            <div class="container-fluid">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    Trafik Cezaları Yönetim Sistemi
                </a>

                <div class="d-flex align-items-center gap-3">
                    <span>@User.Identity?.Name</span>

                    <form method="post" asp-controller="Auth" asp-action="Logout">
                        <button type="submit" class="btn btn-outline-danger">
                            Çıkış Yap
                        </button>
                    </form>
                </div>

            </div>
        </nav>
    </header>

    <div class="container-fluid d-flex flex-column flex-grow-1 px-0">
        <div class="row g-0 flex-grow-1">
            <aside class="col-12 col-md-3 col-lg-2 d-flex">
                <partial name="_Sidebar" />
            </aside>

            <main class="col-12 col-md-9 col-lg-10 bg-light p-3 p-lg-4">
                <div class="card shadow-sm w-100">
                    <div class="card-body p-3 p-lg-4">
                        @RenderBody()
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
