<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trafik Cezaları Yönetim Sistemi</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TrafficFineManagement.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar bg-white border-bottom">
            <div class="container-fluid">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    Trafik Cezaları Yönetim Sistemi
                </a>

                <div class="d-flex align-items-center gap-3">
                    <span>@User.Identity?.Name</span>

                    <form method="post" asp-controller="Auth" asp-action="Logout">
                        <button type="submit" class="btn btn-outline-danger">
                            Çıkış Yap
                        </button>
                    </form>
                </div>

            </div>
        </nav>
    </header>
    <div class="container-fluid px-0">
        <div class="row g-2 mx-0">
            <aside class="col-auto">
                <partial name="_Sidebar" />
            </aside>

            <main role="main" class="col pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TrafficFineManagement.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
