@model TrafficFineManagement.Web.Models.DTOs.Car.CreateCarRequest
@using TrafficFineManagement.Web.Models.Enums

@{
    ViewData["Title"] = "Araç Ekle";
    }

<h1>Araç Ekle</h1>

<partial name="_FormMessage" />

<div class="container">
    <form method="post" asp-action="create" asp-controller="car">
        <div>
            <label for="plate">Plaka Giriniz</label>
            <br />
            <input type="text" id="plate" name="plate" maxlength="9" placeholder="34ABC123" />
        </div>
        <div>
            <label asp-for="CarType">Araç Türü Seçiniz</label>
            <br />

            <select asp-for="CarType"
                    asp-items="Html.GetEnumSelectList<CarType>()"
                    required>
                <option value="">Seçiniz</option>
            </select>
        </div>
        <div>
            <label for="brand">Marka Giriniz</label>
            <br />
            <input type="text" id="brand" name="brand" maxlength="20" />
        </div>
        <div>
            <label for="model">Model Giriniz</label>
            <br />
            <input type="text" id="model" name="model" maxlength="20" />
        </div>
        <div>
            <label for="ownerId">Araç Sahibinin ID Bilgisini Giriniz</label>
            <br />
            <input type="text" id="ownerId" name="ownerId" maxlength="50" />
        </div>
        <div class="p-3">
            <button class="btn btn-primary" type="submit">Kaydet</button>
        </div>
    </form>
</div>
