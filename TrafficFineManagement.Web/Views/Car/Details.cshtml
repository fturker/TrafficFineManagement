@using TrafficFineManagement.Web.Consts
@model TrafficFineManagement.Web.Models.DTOs.Car.CarDetailResponse

@{
    ViewData["Title"] = "Araç Detayı";

    var canManage = User.IsInRole(RoleName.Admin)
        || User.IsInRole(RoleName.SuperAdmin);
}

<h3 class="mb-4">Araç Detayı</h3>

<dl class="row mb-4">
    <dt class="col-sm-4 text-muted">Araç ID</dt>
    <dd class="col-sm-8">@Model.Id</dd>

    <dt class="col-sm-4 text-muted">Plaka</dt>
    <dd class="col-sm-8">@Model.Plate</dd>

    <dt class="col-sm-4 text-muted">Araç Türü</dt>
    <dd class="col-sm-8">@Html.DisplayFor(model => model.CarType)</dd>

    <dt class="col-sm-4 text-muted">Marka</dt>
    <dd class="col-sm-8">@Model.Brand</dd>
    <dt class="col-sm-4 text-muted">Model</dt>
    <dd class="col-sm-8">@Model.Model</dd>

    <dt class="col-sm-4 text-muted">Araç Sahibi</dt>
    <dd class="col-sm-8">@Model.OwnerName @Model.OwnerSurname</dd>
    <dt class="col-sm-4 text-muted">Şirket</dt>
    <dd class="col-sm-8">@Model.CompanyName</dd>

    <dt class="col-sm-4 text-muted">Oluşturulma Tarihi</dt>
    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
</dl>

<div class="row justify-content-around mb-3 col-12 col-md-9">
    <a asp-controller="Car" class="btn btn-primary col-12 col-md-4" asp-action="Index">
        Listeye Dön
    </a>

    @if(canManage)
    {
        <a asp-controller="Car"
           asp-action="Update"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary col-12 col-md-4">
            Düzenle
        </a>
    }
</div>

@if(canManage)
{
    <form method="post"
          asp-controller="Car"
          asp-action="Delete"
          asp-route-id="@Model.Id">

        <p>
            <input class="form-check-input" type="checkbox" id="confirmDelete" required />

            <label class="form-check-label" for="confirmDelete">
                Bu aracı silmek istiyorum.
            </label>
        </p>

        <button class="btn btn-danger" type="submit">Aracı Sil</button>
    </form>
}