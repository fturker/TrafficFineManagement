@using TrafficFineManagement.Web.Models.Enums
@model TrafficFineManagement.Web.Models.DTOs.Car.UpdateCarRequest

@{
    ViewData["Title"] = "Araç Düzenle";
    var id = ViewContext.RouteData.Values["id"];
}

<h3 class="mb-4">Araç Düzenle</h3>

<partial name="_FormMessages" />

<div class="container mb-3">
        <form method="post" asp-action="update" asp-controller="car" asp-route-id="@id">
        <div class="row g-3">
            <div class="mb-3 col-12 col-md-6">
                <label class="form-label" asp-for="Plate">Plaka</label>
                <br />
                <input class="form-control" asp-for="Plate" maxlength="9" required />
            </div>
            <div class="mb-3 col-12 col-md-6">
                <label class="form-label" asp-for="CarType">Araç Türü</label>
                <br />
                <select class="form-select" asp-for="CarType" asp-items="Html.GetEnumSelectList<CarType>()" required>
                    <option value="">Seçiniz</option>
                </select>
            </div>
            <div class="mb-3 col-12 col-md-6">
                <label class="form-label" asp-for="Brand">Marka</label>
                <br />
                <input class="form-control" asp-for="Brand" maxlength="20" required />
            </div>
            <div class="mb-3 col-12 col-md-6">
                <label class="form-label" asp-for="Model">Model</label>
                <br />
                <input class="form-control" asp-for="Model" maxlength="20" required />
            </div>
            <div class="mb-3 col-12 col-md-6">
                <label class="form-label" asp-for="OwnerId">Araç Sahibinin Kullanıcı ID'si</label>
                <br />
                <input class="form-control" asp-for="OwnerId" required />
            </div>
            <div class="p-3">
                <button class="btn btn-primary" type="submit">Güncelle</button>
                <a class="btn btn-secondary" asp-controller="Car" asp-action="Index">Vazgeç</a>
            </div>
        </div>
    </form>
</div>
