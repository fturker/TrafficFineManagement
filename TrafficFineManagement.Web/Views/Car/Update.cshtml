@using TrafficFineManagement.Web.Models.Enums
@model TrafficFineManagement.Web.Models.DTOs.Car.UpdateCarRequest

@{
    ViewData["Title"] = "Araç Düzenle";
    var id = ViewContext.RouteData.Values["id"];
}

<h1>Araç Düzenle</h1>

@if(!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All"
         class="alert alert-danger"
         role="alert">
    </div>
}

<form method="post"
      asp-controller="Car"
      asp-action="Update"
      asp-route-id="@id">

    <p>
        <label asp-for="Plate">Plaka</label>
        <br />

        <input asp-for="Plate" maxlength="9" required />
    </p>

    <p>
        <label asp-for="CarType">Araç Türü</label>
        <br />

        <select asp-for="CarType"
                asp-items="Html.GetEnumSelectList<CarType>()"
                required>
            <option value="">Seçiniz</option>
        </select>
    </p>

    <p>
        <label asp-for="Brand">Marka</label>
        <br />

        <input asp-for="Brand" maxlength="20" required />
    </p>

    <p>
        <label asp-for="Model">Model</label>
        <br />

        <input asp-for="Model" maxlength="20" required />
    </p>

    <p>
        <label asp-for="OwnerId">Araç Sahibinin Kullanıcı ID'si</label>
        <br />

        <input asp-for="OwnerId" required />
    </p>

    <button type="submit">Güncelle</button>

    <a asp-controller="Car" asp-action="Index">
        Vazgeç
    </a>
</form>
