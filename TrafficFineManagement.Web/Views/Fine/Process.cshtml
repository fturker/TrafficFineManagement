@using TrafficFineManagement.Web.Models.Enums
@model TrafficFineManagement.Web.Models.DTOs.Fine.FineDetailResponse

@{
    ViewData["Title"] = "Ceza Süreci";

    var completed = Model.Status == FineStatus.Completed;
    var rejected = Model.Status == FineStatus.Rejected;

    var managerApproved =
        Model.Status == FineStatus.ManagerApproved ||
        completed ||
        Model.Histories.Any(h =>
            h.NewStatus == FineStatus.ManagerApproved);

    var steps = new[]
    {
        new
        {
            Title = "Ceza Oluşturuldu",
            Description = "Ceza kaydı oluşturuldu.",
            Color = "bg-success",
            LineColor = managerApproved ? "border-success" : "border-warning"
        },
        new
        {
            Title = "Yönetici Onayı",
            Description = managerApproved ? "Onaylandı."
                : rejected ? "Reddedildi."
                : "Yönetici onayı bekleniyor.",
            Color = managerApproved ? "bg-success"
                : rejected ? "bg-danger"
                : "bg-warning",
            LineColor = completed ? "border-success" : "border-warning"
        },
        new
        {
            Title = "Finans Onayı",
            Description = completed ? "Süreç tamamlandı."
                : rejected && managerApproved ? "Reddedildi."
                : rejected ? "Bu aşamaya geçilmedi."
                : managerApproved ? "Onay bekleniyor."
                : "Finans onayı bekleniyor.",
            Color = completed ? "bg-success"
                : rejected && managerApproved ? "bg-danger"
                : "bg-warning",
            LineColor = ""
        }
    };

    var isCompleted = Model.Status == FineStatus.Completed;
    var isRejected = Model.Status == FineStatus.Rejected;
}

<h3 class="mb-4">Ceza Süreci</h3>

<partial name="_FormMessages" />

<p><strong>Plaka:</strong> @Model.Plate</p>
<p><strong>Tutar:</strong> @Model.Amount.ToString("N2") TL</p>

<p class="mb-5">
    <strong>Mevcut Durum:</strong>
    <span class="@(isCompleted ? "text-success" : isRejected ? "text-danger" : "")">
        @Html.DisplayFor(model => model.Status)
    </span>
</p>

<h4 class="mb-4">İşlem Geçmişi</h4>

@if (Model.Histories.Count == 0)
{
    <p>İşlem geçmişi bulunamadı.</p>
}
else
{
    <div class="row g-4">
        <div class="col-12 col-lg-9">
            <table class="table table-striped table-hover table-responsive">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>İşlemi Yapan</th>
                        <th>İşlem</th>
                        <th>Açıklama</th>
                        <th>Önceki Durum</th>
                        <th>Yeni Durum</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var history in Model.Histories)
                    {
                        <tr>
                            <td>
                                @history.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </td>

                            <td>@history.UserDisplayName</td>

                            <td>
                                @Html.DisplayFor(_ => history.ActionType)
                            </td>

                            <td>@history.Description</td>

                            <td>
                                @if (history.PreviousStatus.HasValue)
                                {
                                    @Html.DisplayFor(_ => history.PreviousStatus)
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>

                            <td>
                                @Html.DisplayFor(_ => history.NewStatus)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="col-12 col-lg-3">
            <div class="card shadow bg-white rounded">
                <div class="card-body p-4">
                    <h2 class="h5 mb-4">Onay Süreci</h2>

                    <ol class="list-unstyled mb-0">
                        @for (var i = 0; i < steps.Length; i++)
                        {
                            var step = steps[i];
                            var isLast = i == steps.Length - 1;

                            <li class="d-flex">
                                <div class="d-flex flex-column align-items-center me-3">
                                    <span class="d-block rounded-circle p-3 flex-shrink-0 @step.Color"
                                          aria-hidden="true">
                                    </span>

                                    @if (!isLast)
                                    {
                                        <div class="border-start border-2 flex-grow-1 @step.LineColor"
                                             aria-hidden="true">
                                        </div>
                                    }
                                </div>

                                <div class="@(isLast ? "" : "pb-4")">
                                    <div class="fw-semibold">
                                        @step.Title
                                    </div>

                                    <p class="small text-muted mb-0 mt-1">
                                        @step.Description
                                    </p>
                                </div>
                            </li>
                        }
                    </ol>
                </div>
            </div>
        </div>
    </div>
}

<p class="mt-3">
    <a asp-controller="Fine"
       asp-action="Details"
       asp-route-id="@Model.Id"
       class="btn btn-outline-primary p-2">
        Ceza Detayına Dön
    </a>
</p>
