@model TrafficFineManagement.Web.Models.DTOs.Fine.CreateFineRequest

@{
    ViewData["Title"] = "Ceza Oluştur";
}

<h3 class="mb-4">Ceza Oluştur</h3>

<partial name="_FormMessages" />

<div class="container mb-3">
    <form method="post"
          asp-controller="Fine"
          asp-action="Create">

        <div class="row g-3">
            <div class=" col-12 col-md-6 mb-3">
                <label asp-for="CarId" class="form-label">Araç ID</label>
                <br />

                <input asp-for="CarId"
                       type="number"
                       min="1"
                       class="form-control"
                       required />
            </div>

            <div class="col-12 col-md-6 mb-3"> 
                <label asp-for="Amount" class="form-label">Tutar (TL)</label>
                <br />

                <input asp-for="Amount"
                       type="text"
                       inputmode="decimal"
                       class="form-control"
                       maxlength="8"
                       required />
            </div>

            <div class="col-12 col-md-6 mb-3">
                <label asp-for="FineDate" class="form-label">Ceza Tarihi</label>
                <br />

                <input asp-for="FineDate"
                       type="date"
                       class="form-control"
                       required />
            </div>

            <div class="col-12 col-md-6 mb-3">
                <label asp-for="Description" class="form-label">Açıklama</label>
                <br />

                <textarea asp-for="Description"
                          rows="4"
                          cols="40"
                          maxlength="1000"
                          class="form-control"
                          required></textarea>
            </div>

            <div class="row g-3 justify-content-around">
                <button type="submit" class="btn btn-primary col-12 col-md-5">
                    Kaydet
                </button>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-primary col-12 col-md-5">
                    Ana Sayfa
                </a>
            </div>
        </div>
    </form>
</div>