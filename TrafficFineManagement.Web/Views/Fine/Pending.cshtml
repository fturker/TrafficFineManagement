@using TrafficFineManagement.Web.Models.DTOs.Fine
@model List<FineListResponse>

<h3 class="mb-4">@ViewData["Title"]</h3>

<partial name="_FormMessages" />

@if (Model.Count == 0)
{
    <p>Onay bekleyen ceza bulunamadı.</p>
}
else
{
    <div class="mb-3">
        <table class="table table-striped table-hover table-responsive">
            <thead>
                <tr>
                    <th>Ceza ID</th>
                    <th>Plaka</th>
                    <th>Tutar</th>
                    <th>Tarih</th>
                    <th>Detay</th>
                    <th>Onay / Ret</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var fine in Model)
                {
                    <tr>
                        <td>@fine.Id</td>
                        <td>@fine.Plate</td>
                        <td>@fine.Amount.ToString("N2") TL</td>
                        <td>@fine.FineDate.ToString("dd.MM.yyyy")</td>

                        <td>
                            <a asp-controller="Fine"
                               asp-action="Details"
                               asp-route-id="@fine.Id"
                                class="btn btn-outline-primary">
                                Detay ve Geçmiş
                            </a>
                        </td>

                        <td>
                            <form method="post"
                                  asp-controller="Fine"
                                  asp-action="Approve"
                                  asp-route-id="@fine.Id">

                                <input type="hidden"
                                       name="ExpectedStatus"
                                       value="@((int)fine.Status)" />

                                <p>
                                    <label for="description-@fine.Id" class="mb-2">
                                        İşlem Açıklaması
                                    </label>
                                    <br />

                                    <textarea id="description-@fine.Id"
                                      name="Description"
                                      rows="2"
                                      maxlength="500"
                                      required></textarea>
                                </p>

                                <button type="submit" class="btn btn-success me-2">
                                    Onayla
                                </button>

                                <button type="submit"
                                        asp-controller="Fine"
                                        asp-action="Reject"
                                        asp-route-id="@fine.Id"
                                        class="btn btn-danger">
                                    Reddet
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
