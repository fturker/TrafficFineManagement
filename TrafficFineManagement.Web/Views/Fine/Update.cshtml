@model TrafficFineManagement.Web.Models.DTOs.Fine.UpdateFineRequest

@{
    ViewData["Title"] = "Ceza Düzenle";
    var id = ViewContext.RouteData.Values["id"];
}

<h3 class="mb-4">Ceza Düzenle</h3>

<partial name="_FormMessages" />

<div class="container mb-3">
    <form method="post"
          asp-controller="Fine"
          asp-action="Update"
          asp-route-id="@id">

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <label asp-for="Amount" class="form-label">
                    Tutar (TL)
                </label>

                <input asp-for="Amount"
                       type="text"
                       inputmode="decimal"
                       class="form-control"
                       required />
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="FineDate" class="form-label">
                    Ceza Tarihi
                </label>

                <input asp-for="FineDate"
                       type="date"
                       class="form-control"
                       required />
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label">
                    Açıklama
                </label>

                <textarea asp-for="Description"
                          rows="4"
                          maxlength="1000"
                          class="form-control"
                          required></textarea>
            </div>
        </div>
        <div class="row g-3 justify-content-around w-100">
            <div class="col-12 col-md-5">
                <button type="submit"
                        class="btn btn-primary">
                    Güncelle
                </button>
            </div>

            <div class="col-12 col-md-5">
                <a asp-controller="Fine"
                   asp-action="Details"
                   asp-route-id="@id"
                   class="btn btn-outline-primary">
                    Vazgeç
                </a>
            </div>
        </div>
    </form>
</div>