@using TrafficFineManagement.Web.Models.DTOs.Fine
@model List<FineListResponse>

@{
    ViewData["Title"] = "Yazdığım Cezalar";

    var filter = ViewData["Filter"] as FineFilterRequest
        ?? new FineFilterRequest();
}

<h1>Yazdığım Cezalar</h1>

<partial name="_FormMessages" />

<p>
    <a asp-controller="Fine"
       asp-action="Create"
       class="btn btn-primary">
        Ceza Oluştur
    </a>
</p>

@if (Model.Count == 0)
{
    <p>Bu sayfada oluşturduğunuz ceza bulunamadı.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Ceza ID</th>
                <th>Plaka</th>
                <th>Tutar</th>
                <th>Tarih</th>
                <th>Durum</th>
                <th>İşlem</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var fine in Model)
            {
                <tr>
                    <td>@fine.Id</td>
                    <td>@fine.Plate</td>
                    <td>@fine.Amount.ToString("N2") TL</td>
                    <td>@fine.FineDate.ToString("dd.MM.yyyy")</td>
                    <td>@Html.DisplayFor(_ => fine.Status)</td>

                    <td>
                        <a asp-controller="Fine"
                           asp-action="Details"
                           asp-route-id="@fine.Id">
                            Detay
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (ViewData.ModelState.IsValid)
{
    <p>
        @if (filter.PageNumber > 1)
        {
            <a asp-controller="Fine"
               asp-action="CreatedByMe"
               asp-route-pageNumber="@(filter.PageNumber - 1)"
               asp-route-pageSize="@filter.PageSize">
                Önceki
            </a>
        }

        <span>Sayfa @filter.PageNumber</span>

        @if (Model.Count == filter.PageSize)
        {
            <a asp-controller="Fine"
               asp-action="CreatedByMe"
               asp-route-pageNumber="@(filter.PageNumber + 1)"
               asp-route-pageSize="@filter.PageSize">
                Sonraki
            </a>
        }
    </p>
}