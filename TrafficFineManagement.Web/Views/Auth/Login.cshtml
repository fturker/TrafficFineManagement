@model TrafficFineManagement.Web.Models.DTOs.Auth.LoginRequest

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Giriş Yap | Trafik Cezaları Yönetim Sistemi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    </head>
    <body class="login-page bg-secondary bg-opacity-10">
        <main class="min-vh-100 d-flex align-items-center justify-content-center p-3">
        <div class="login-container">
            <header class="fs-4 fw-bold mb-2">
                <h2 class="fs-4 fw-bold mb-2">
                    Trafik Cezaları Yönetim Sistemi
                </h2>
            </header>

            <section class="login-card card p-4 p-sm-5 shadow bg-white rounded">
                <h2 class="fs-5 fw-bold mb-4">Hoş Geldiniz</h2>

                <form method="post" asp-action="Login" asp-controller="Auth">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All"
                             class="alert alert-danger"
                             role="alert">
                        </div>
                    }

                    <div class="form-group mb-3">
                        <label for="identifier" class="form-label">TC No / Vergi No ya da Kullanıcı Adı</label>
                        <br />
                        <input type="text" id="identifier" name="identifier"
                               class="form-control form-control-lg"
                               placeholder="TC No / Vergi No ya da Kullanıcı Adınızı Giriniz" 
                               maxlength="11" required />
                    </div>
                    <div class="form-group mb-4">
                        <label for="password" class="form-label">Şifre</label>
                        <br />
                        <input type="password" id="password" name="password"
                               class="form-control form-control-lg" placeholder="Şifrenizi Giriniz" 
                               maxLe maxlength="8" required />
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100">Giriş Yap</button>
                </form>
            </section>

        </div>
        </main>
    </body>
</html>