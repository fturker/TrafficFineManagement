@using TrafficFineManagement.Web.Models.DTOs.Fine
@model List<FineListResponse>

@{
    ViewData["Title"] = "Cezalarım";

    var filter = ViewData["Filter"] as FineFilterRequest
        ?? new FineFilterRequest();
}

<h3 class="mb-4">Cezalarım</h3>

<partial name="_FormMessages" />

@if (Model.Count == 0)
{
    <p>Adınıza kayıtlı ceza kaydı bulunamadı.</p>
}
else
{
    <div class="mb-3">
        <table class="table table-striped table-hover table-responsive">
            <thead>
                <tr>
                    <th>Ceza ID</th>
                    <th>Plaka</th>
                    <th>Tutar</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th>Ödeme</th>
                    <th>İşlem</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var fine in Model)
                {
                    <tr>
                        <td>@fine.Id</td>
                        <td>@fine.Plate</td>
                        <td>@fine.Amount.ToString("N2") TL</td>
                        <td>@fine.FineDate.ToString("dd.MM.yyyy")</td>
                        <td>@Html.DisplayFor(_ => fine.Status)</td>
                        <td>@(fine.IsPaid ? "Ödendi" : "Ödenmedi")</td>
                        <td>
                            @if (!fine.IsPaid)
                            {
                                <a asp-controller="Payment"
                                   asp-action="Pay"
                                   asp-route-fineId="@fine.Id"
                                   class="btn btn-primary">
                                    Öde
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pagination" />
}